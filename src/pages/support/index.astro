---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site.mjs';
import { href } from '../../lib/url.mjs';
import FaqEntries from '../../components/FaqEntries.astro';
const mail = site.contactEmail;
const sn = site.serviceName;
const tips = ['가입한 로그인 방식(카카오·구글·애플)', '앱에서 쓰는 닉네임', '휴대폰 기종과 앱 버전', '문제가 생긴 화면의 캡처'];
// 메일 제목은 디자이너 2 시안(HP-support 2차) 그대로, 본문은 「메일에 적어 주시면…」 4줄을 미리 채움
const mk = (subject, body = '') => `mailto:${mail}?subject=${encodeURIComponent(`[${sn}] ${subject}`)}${body ? `&body=${encodeURIComponent(body)}` : ''}`;
const mailto = mk('문의', ['가입한 로그인 방식(카카오 / 구글 / 애플):', '앱에서 쓰는 닉네임:', '휴대폰 기종과 앱 버전:', '문제가 생긴 화면의 캡처: (첨부해 주세요)'].join('\n'));
const cases = [
  { q: '게시물·사용자 신고', a: '앱에서 해당 추억·댓글·프로필의 신고 버튼을 눌러 주세요.' },
  { q: '신고 처리나 이용 제한에 이의가 있어요', a: `조치를 안 날부터 30일 안에 ${mail}로 알려 주세요.`, mail: '신고 처리 이의' },
  { q: '내 개인정보를 열람·정정·삭제하고 싶어요', a: `앱에서 직접 할 수 없는 요청은 ${mail}로 보내 주세요. 본인인지 확인하고, 요청을 받은 날부터 10일 안에 결과를 알려 드려요.`, mail: '개인정보 열람·정정·삭제' },
  { q: '가족을 떠났는데 내가 기록한 경로를 지우고 싶어요', a: `${mail}로 요청해 주세요.`, mail: '가족 탈퇴 후 경로 삭제' },
  { q: '회원이 아닌데 내 권리를 침해하는 게시물이 있어요', a: `게시물을 알아볼 수 있는 정보와 침해라고 생각하는 이유를 적어 ${mail}로 보내 주세요.`, mail: '권리 침해 신고' },
];

---
<Base title="고객센터" wide>
  <div class="sp">
    <div class="sp-top">
      <h1>무엇을 도와드릴까요?</h1>
      <p><a class="sp-mail" href={`mailto:${mail}`}>{mail}</a>로 보내 주세요. {site.replyTime} 안에 답해 드려요.</p>
    </div>

    <section class="sp-sec">
      <h2>자주 묻는 질문</h2>
      <div class="sp-faq"><FaqEntries mode="details" /></div>
    </section>

    <section class="sp-sec" id="requests">
      <h2>요청별 안내</h2>
      <p class="sp-hint">메일 줄을 누르면 제목이 채워진 메일이 열려요.</p>
      <div class="sp-card sp-cases">
        {cases.map((c) => c.mail ? (
          <a class="sp-case sp-case-link" href={mk(c.mail)}><span class="sp-q">{c.q}</span><span class="sp-a">{c.a}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        ) : (
          <div class="sp-case"><span class="sp-q">{c.q}</span><span class="sp-a">{c.a}</span></div>
        ))}
        <div class="sp-case"><span class="sp-q">탈퇴</span><span class="sp-a">앱의 {site.appDeletePath}에서 하거나, 앱이 없다면 <a href={href('/account/delete/')}>계정 삭제 안내</a>를 따라 주세요.</span></div>
      </div>
    </section>

    <section class="sp-sec">
      <h2>메일에 적어 주시면 빨리 도와드릴 수 있어요</h2>
      <div class="sp-card sp-tips">
        {tips.map((x) => <span>{x}</span>)}
      </div>
      <a class="button sp-btn sp-mailbtn" href={mailto}>문의 메일 쓰기</a>
    </section>

    <a class="sp-back" href={href('/')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>서비스 소개로 돌아가기</a>
  </div>
</Base>
