---
import Base from '../../layouts/Base.astro';
import { site } from '../../config/site.mjs';
import { href } from '../../lib/url.mjs';
import FaqEntries from '../../components/FaqEntries.astro';
const mail = site.contactEmail;
const mailto = `mailto:${mail}?subject=${encodeURIComponent(`${site.serviceName} 문의`)}`;
---
<Base title="고객센터" wide>
  <div class="sp">
    <div class="sp-top">
      <h1>무엇을 도와드릴까요?</h1>
      <p>{mail}로 보내 주세요. {site.replyTime} 안에 답해 드려요.</p>
      <a class="button sp-btn" href={mailto}>문의 메일 쓰기</a>
    </div>

    <section class="sp-sec">
      <h2>메일에 적어 주시면 빨리 도와드릴 수 있어요</h2>
      <div class="sp-card sp-tips">
        <span>가입한 로그인 방식(카카오·구글·애플)</span>
        <span>앱에서 쓰는 닉네임</span>
        <span>휴대폰 기종과 앱 버전</span>
        <span>문제가 생긴 화면의 캡처</span>
      </div>
    </section>

    <section class="sp-sec">
      <h2>요청별 안내</h2>
      <div class="sp-card sp-cases">
        <div class="sp-case"><span class="sp-q">게시물·사용자 신고</span><span class="sp-a">앱에서 해당 추억·댓글·프로필의 신고 버튼을 눌러 주세요.</span></div>
        <div class="sp-case"><span class="sp-q">신고 처리나 이용 제한에 이의가 있어요</span><span class="sp-a">조치를 안 날부터 30일 안에 {mail}로 알려 주세요.</span></div>
        <div class="sp-case"><span class="sp-q">내 개인정보를 열람·정정·삭제하고 싶어요</span><span class="sp-a">앱에서 직접 할 수 없는 요청은 {mail}로 보내 주세요. 본인인지 확인하고, 요청을 받은 날부터 10일 안에 결과를 알려 드려요.</span></div>
        <div class="sp-case"><span class="sp-q">가족을 떠났는데 내가 기록한 경로를 지우고 싶어요</span><span class="sp-a">{mail}로 요청해 주세요.</span></div>
        <div class="sp-case"><span class="sp-q">회원이 아닌데 내 권리를 침해하는 게시물이 있어요</span><span class="sp-a">게시물을 알아볼 수 있는 정보와 침해라고 생각하는 이유를 적어 {mail}로 보내 주세요.</span></div>
        <div class="sp-case"><span class="sp-q">탈퇴</span><span class="sp-a">앱에서 하거나, 앱이 없다면 <a href={href('/account/delete/')}>계정 삭제 안내</a>를 따라 주세요.</span></div>
      </div>
    </section>

    <section class="sp-sec">
      <h2>자주 묻는 질문</h2>
      <div class="sp-faq"><FaqEntries mode="details" /></div>
    </section>

    <a class="sp-back" href={href('/')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"></path></svg>서비스 소개로 돌아가기</a>
  </div>
</Base>
