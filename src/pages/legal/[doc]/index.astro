---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import LegalDoc from '../../../components/LegalDoc.astro';
import { DOCS, currentVersion, upcomingVersion, todayKST } from '../../../lib/legal.mjs';
import { legalByDoc, previewByDoc } from '../../../lib/legal-data';
import { href } from '../../../lib/url.mjs';

export function getStaticPaths() {
  return Object.keys(DOCS).map((doc) => ({ params: { doc } }));
}

const { doc } = Astro.params;
const versions = (await legalByDoc())[doc];
const today = todayKST();
const current = currentVersion(versions, today);
const next = upcomingVersion(versions, today);
// 임시 초안은 정식 현재본이 없을 때만 보여 줍니다.
const preview = current ? undefined : (await previewByDoc())[doc];
const Preview = preview && (await render(preview)).Content;
---
<Base title={DOCS[doc]} noindex={!!preview}>
  {Preview ? (
    <>
      <p class="notice">초안·테스트용 문서예요. 법률 검토를 마치지 않은 초안으로, 실제 서비스에 적용되는 약관이 아니에요. 정식 문서는 출시 전에 이 주소에 게시돼요.</p>
      <div class="legal-body"><Preview /></div>
    </>
  ) : (
    <LegalDoc doc={doc} versions={versions} shown={current}>
      {next && (
        <p class="notice">{next.effective}부터 새 버전이 시행돼요. <a href={href(`/legal/${doc}/${next.version}/`)}>새 버전 미리 보기</a></p>
      )}
    </LegalDoc>
  )}
</Base>
