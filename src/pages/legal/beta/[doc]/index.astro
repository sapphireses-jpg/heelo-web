---
import Base from '../../../../layouts/Base.astro';
import BetaDoc from '../../../../components/BetaDoc.astro';
import { DOCS } from '../../../../lib/legal.mjs';
import { betaByDoc } from '../../../../lib/legal-data';

// 베타 적용판(앱 링크가 이 주소): 최신 게시 버전을 보여 줍니다. published만 배포되고, draft는 astro dev에서만 보입니다.
export async function getStaticPaths() {
  return Object.entries(await betaByDoc()).map(([doc, versions]) => ({ params: { doc }, props: { versions } }));
}

const { doc } = Astro.params;
const { versions } = Astro.props;
---
<Base title={`${DOCS[doc]} (비공개 베타)`}>
  <BetaDoc doc={doc} entry={versions[0]} versions={versions} />
</Base>
