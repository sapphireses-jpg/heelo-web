---
import { site } from '../config/site.mjs';
import { href } from '../lib/url.mjs';
// 자주 묻는 질문 한 곳(고객센터와 홈이 같은 문안을 씁니다). only = 보여 줄 id 목록(없으면 전부), mode = 'plain'(제목+답) | 'details'(접고 펴기, 자바스크립트 없음)
const { only, mode = 'plain' } = Astro.props;
const mail = site.contactEmail;
const all = [
  { id: 'withdraw', q: '탈퇴하면 기록은 언제 지워지나요?', html: `<p>탈퇴를 요청하면 바로 모든 기기에서 로그아웃되고 다른 사람에게 보이지 않아요. 30일 안에 다시 로그인해 「계정 복구하기」를 누르면 되돌릴 수 있고, 30일이 지나면 삭제돼 복구할 수 없어요. 자세한 내용은 <a href="${href('/account/delete/')}">계정 삭제 안내</a>에 있어요.</p>` },
  { id: 'location', q: '위치는 언제 수집하나요?', html: `<p>산책을 시작한 때부터 끝낼 때까지만 기록해요. 화면이 꺼지거나 잠겨 있어도 산책 중이면 기록돼요. 홈 화면 날씨에는 대략적인 위치만 쓰고 저장하지 않아요.</p>` },
  { id: 'revoke', q: '위치정보 이용 동의를 철회하면 어떻게 되나요?', html: `<p>산책 경로, 방문 장소, 발견, 새로운 길 기록과 거리, 사진 촬영 위치가 지워져요. 그에 관한 위치정보 확인자료도 함께 지워져요. 가족 공유 강아지와 걸은 내 경로도 함께 지워져요. 산책 날짜와 시간, 총 거리, 함께 걸은 강아지는 남아요. 산책 중에는 철회할 수 없으니 산책을 끝낸 뒤 해 주세요.</p>` },
  { id: 'family-size', q: '가족은 몇 명까지 함께할 수 있나요?', html: `<p>대표가 최대 4명까지 초대할 수 있어요. 한 계정은 한 가족에만 속할 수 있어요. 가족끼리는 경로 열람에 동의한 뒤, 함께 기록하는 강아지(공유 강아지)와 걸은 서로의 산책 경로를 볼 수 있어요. 각자의 개인 강아지는 공유되지 않아요.</p>` },
  { id: 'family-leave', q: '가족을 떠나면 내가 기록한 산책은 어떻게 되나요?', html: `<p>공유 강아지의 산책 기록은 그 강아지의 기록으로 남고, 기록한 사람 표시만 지워져요. 경로까지 지우고 싶다면 ${mail}로 요청해 주세요.</p>` },
  { id: 'photo-location', q: '추억 사진에 위치가 남나요?', html: `<p>올리는 사진의 촬영 위치 정보는 지운 뒤 저장해요. 산책 중 앱 카메라로 찍은 사진의 촬영 위치는 따로 저장되고, 찍은 사람만 볼 수 있어요.</p>` },
  { id: 'report', q: '불쾌한 게시물을 봤어요.', html: `<p>앱에서 신고해 주세요. 신고를 받으면 24시간 안에 검토하는 것을 목표로 하고 있어요. 신고한 사람의 정보는 상대에게 알리지 않아요.</p>` },
];
const list = only ? only.map((id) => all.find((e) => e.id === id)).filter(Boolean) : all;
---
{list.map((e) =>
  mode === 'details' ? (
    <details class="faq">
      <summary>{e.q}</summary>
      <Fragment set:html={e.html} />
    </details>
  ) : (
    <>
      <h3>{e.q}</h3>
      <Fragment set:html={e.html} />
    </>
  ),
)}
