---
import { site } from '../config/site.mjs';
import { href } from '../lib/url.mjs';
---
{site.launchStatus === 'live' ? (
  <p class="store-links">
    {site.storeLinks.appStore && <a class="store-badge" href={site.storeLinks.appStore}><img src={href('/badges/app-store.svg')} alt="App Store에서 다운로드" height="48" width="156"></a>}
    {site.storeLinks.googlePlay
      ? <a class="store-badge" href={site.storeLinks.googlePlay}><img class="gp" src={href('/badges/google-play.png')} alt="Google Play에서 다운로드" height="64" width="165"></a>
      : <span class="store-soon">Google Play 곧 열려요</span>}
  </p>
) : (
  <p><strong>지금 출시를 준비하고 있어요.</strong></p>
)}
