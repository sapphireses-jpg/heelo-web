---
import { site } from '../config/site.mjs';
---
{site.launchStatus === 'live' ? (
  <p class="store-links">
    {site.storeLinks.appStore && <a class="button" href={site.storeLinks.appStore}>App Store에서 받기</a>}
    {site.storeLinks.googlePlay
      ? <a class="button" href={site.storeLinks.googlePlay}>Google Play에서 받기</a>
      : <span class="store-soon">Google Play 곧 열려요</span>}
  </p>
) : (
  <p><strong>지금 출시를 준비하고 있어요.</strong></p>
)}
