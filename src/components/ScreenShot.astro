---
import { existsSync } from 'node:fs';
import { href } from '../lib/url.mjs';
// 앱 화면 이미지 한 장. public/screens/<name>.webp 가 있을 때만 그립니다(없으면 아무것도 안 그림).
// 이미지는 데모 데이터만(공개 저장소). 크기 안내는 docs/CONTENT.md의 화면 이미지 항목.
const { name, alt, class: cls = '' } = Astro.props;
const exists = existsSync(`public/screens/${name}.webp`);
---
{exists && (
  <figure class={`shot ${cls}`}>
    <img src={href(`/screens/${name}.webp`)} alt={alt} loading="lazy" decoding="async">
  </figure>
)}
